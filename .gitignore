# ==========================================
# Byte-compiled / optimized / DLL files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.bak
*.dat
*.dir

# ==========================================
# Environments & Virtual Envs
# ==========================================
.env
.env.*
!.env.example
!.env.example.*
src/.env
src/.env.*
!src/.env.example
docker/env/.env*
!docker/env/.env.example*

.venv/
venv/
ENV/
env/
src/venv/
src/.venv/
env.bak/
venv.bak/

# ==========================================
# Databases & Local Vector Stores
# ==========================================
*.sqlite3
*.sqlite3-journal
*.db
qdrant_db/
src/qdrant_db/

# ==========================================
