# ==========================================
src/assets/files/*
!src/assets/files/.gitkeep
src/assets/database/*
!src/assets/database/.gitkeep

# ==========================================
# Celery & Background Task Artifacts
# ==========================================
celerybeat-schedule*
celerybeat.pid
*.pid
*.log

